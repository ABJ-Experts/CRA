# Copy to .env.local and fill in. `.env*` is gitignored except these examples.
#
# Supabase local ports come from apps/infrastructure/supabase/config.toml:
#   API gateway 54321 · Postgres 54322 · Studio 54323 · Mailpit 54324

# --- Postgres (Supabase local DB, DIRECT connection on 54322) ----------------
# ADR-005 / SEC-014: the application connects as the RESTRICTED cras_app role.
# Booting as a superuser silently disables every RLS policy while every test
# still passes, so assertRlsBootSafety() refuses to start.
DATABASE_URL=postgresql://cras_app:cras_app_local_dev@127.0.0.1:54322/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
FEED_DATABASE_URL=postgresql://cras_feed:cras_feed_local_dev@127.0.0.1:54322/postgres
SCHEDULER_DATABASE_URL=postgresql://cras_scheduler:cras_scheduler_local_dev@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=10

# --- Redis (docker-compose.dev.yml) -----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (ADR-013) -----------------------------------------------
# `memory` is PER-PROCESS: the API and the worker would not see each other's
# objects and nothing survives a restart, so evidence upload -> worker read is
# silently broken. Use s3 against Supabase Storage locally; reserve `memory`
# for unit tests.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_BUCKET=cra-sentinel
STORAGE_REGION=local
STORAGE_ACCESS_KEY_ID=replace_me
STORAGE_SECRET_ACCESS_KEY=replace_me
STORAGE_SIGNED_URL_TTL=300

# --- API process ------------------------------------------------------------
PORT=3333
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# --- Matching quality (FR-MATCH-003) ----------------------------------------
MATCH_CONFIDENCE_THRESHOLD=0.7

# --- AI subsystem gateway mode (mock | live) --------------------------------
AI_PROVIDER_MODE=mock

# --- Supabase (server-side) -------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Web -> API ------------------------------------------------------------
# The browser never calls the API or GoTrue directly: /api/cras/* proxies to
# the API and /api/auth/* performs the GoTrue handshake, both server-side, so
# the httpOnly session cookie can be set. These are therefore NOT NEXT_PUBLIC_.
API_URL=http://127.0.0.1:3333

# --- Cookie session (Next route handlers; NEVER NEXT_PUBLIC_) ---------------
SESSION_COOKIE_SECURE=false
# Playwright drives http on 127.0.0.1, so Secure must stay off there too.

# --- Demo / template screens ------------------------------------------------
# Opt-OUT in development: unset (or anything but "false") starts the MSW fixture
# backend. Set it to "false" to turn the demo screens off. In production the
# mocks are hard-off regardless of this flag — shipping a service worker that
# answers /api/* with fixtures would silently replace the real API.
#
# The demo screens live at /dashboard/** and /showcase and are the only
# consumers. The REAL product UI is under /app/** and never touches MSW; it goes
# through /api/cras/* to apps/api.
NEXT_PUBLIC_ENABLE_MOCKS=true

# --- End-to-end -------------------------------------------------------------
E2E_WEB_PORT=3100
E2E_API_PORT=3333
