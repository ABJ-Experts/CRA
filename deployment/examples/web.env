NODE_ENV=production
NEXT_PUBLIC_ENABLE_MOCKS=false
API_ORIGIN=http://api:3333
# Server-only runtime trust origin. Match the API SUPABASE_URL and GoTrue issuer.
SUPABASE_INTERNAL_URL=http://gateway:8000
# Provision SUPABASE_JWT_SECRET locally for algorithm-aware HS256 verification.
SUPABASE_JWT_SECRET=PROVISION_LOCALLY
