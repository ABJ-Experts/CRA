NODE_ENV=production
PORT=3333
WEB_ORIGIN=https://cra.example.invalid
# Provision locally with restrictive permissions. Never package real values.
SUPABASE_URL=http://gateway:8000
SUPABASE_SERVICE_ROLE_KEY=PROVISION_LOCALLY
SUPABASE_JWT_SECRET=PROVISION_LOCALLY
TRUSTED_PROXY_ADDRESSES=PROVISION_FIXED_EDGE_ADDRESS
AGENT_TLS_KEY_PATH=/run/cra-agent/server.key
AGENT_TLS_CERT_PATH=/run/cra-agent/server.crt
AGENT_CA_CERT_PATH=/run/cra-agent/ca.crt
AGENT_CA_KEY_PATH=/run/cra-agent/ca.key
CONNECTOR_VAULT_KEYRING=PROVISION_LOCALLY
