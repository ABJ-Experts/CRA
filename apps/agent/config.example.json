{
  "ingressUrl": "https://cra-agent-ingress.example.com:3443/",
  "stateDir": "/var/lib/cra-agent",
  "serverCaFile": "/etc/cra-agent/server-ca.pem",
  "enrollmentTokenFile": "/etc/cra-agent/enrollment-token",
  "sources": [
    {
      "id": "plm-export",
      "type": "file",
      "path": "/srv/plm-export/records.ndjson"
    }
  ],
  "pollIntervalMs": 10000,
  "timeoutMs": 15000,
  "maxRecords": 200,
  "maxReadBytes": 1048576,
  "maxQueueBytes": 268435456
}
