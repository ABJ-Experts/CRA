# =============================================================================
# apps/api environment
# =============================================================================
# Copy to .env and fill in from `pnpm --filter infrastructure run db:status`.
# .env is gitignored (the root .gitignore matches `.env*` and re-includes
# `*.example`), so this file is the only one that is committed.
# =============================================================================

NODE_ENV=development
PORT=3333

# --- Supabase ----------------------------------------------------------------
# All three come from `db:status`. SUPABASE_JWT_SECRET must be IDENTICAL to the
# one apps/web uses: the web middleware verifies the access token locally, and
# if the two disagree every request 401s with nothing in either log explaining
# why. Both processes print a fingerprint of it at boot so they can be compared.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Web / CORS --------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# --- Cookies -----------------------------------------------------------------
# Leave COOKIE_DOMAIN BLANK locally. Setting it to `localhost` makes some
# browsers drop the cookie silently.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_MAX_AGE=3600
REFRESH_TOKEN_MAX_AGE=604800
# HMAC key for the signed pending / MFA / active-organization cookies.
COOKIE_SIGNING_SECRET=dev-only-cookie-signing-secret-change-me

# --- Mail (Mailpit) ----------------------------------------------------------
# Mailpit's SMTP port, not its web UI (which is 54324). It has NO auth, so
# SMTP_USER/SMTP_PASS stay empty and the transport is built from the host alone.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CRA <no-reply@cra.test>

# --- Security knobs ----------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_MINUTES=15
RECOVERY_TTL_MINUTES=60
INVITATION_TTL_DAYS=7
# Tolerance when comparing a JWT's `iat` to users.session_epoch_at.
# KEEP AT 0 unless the GoTrue and Postgres clocks genuinely disagree: any
# positive value is a window in which a revoked token still works.
SESSION_EPOCH_SKEW_SECONDS=0
