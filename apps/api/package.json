{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "openapi": "vitest run src/openapi.spec.ts",
    "dev": "tsx watch src/main.ts",
    "serve": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.main.ts",
    "worker:dev": "tsx watch src/worker.main.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" && eslint --config eslint.boundaries.mjs \"src/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@repo/sbom-core": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "11.2.0",
    "bullmq": "5.81.2",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "1.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.10",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.5.0",
    "prettier": "catalog:",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
