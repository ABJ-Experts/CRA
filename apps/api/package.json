{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src test --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "worker:tenant-lifecycle": "node dist/tenant-lifecycle-worker.js",
    "worker:product-retention": "node dist/product-retention-worker.js",
    "worker:finding-propagation": "node dist/finding-propagation-worker.js",
    "worker:product-import": "node dist/product-import-worker.js",
    "worker:product-compliance": "node dist/product-compliance-worker.js",
    "worker:connector-sync": "node dist/connector-sync-worker.js",
    "worker:sbom-ingest": "node dist/sbom-ingest-worker.js",
    "worker:sbom-quality": "node dist/sbom-quality-worker.js",
    "worker:sbom-diff": "node dist/sbom-diff-worker.js",
    "verify:tenant-export-capacity": "node dist/organizations/tenant-administration/worker/tenant-export-capacity.js"
  },
  "dependencies": {
    "@cyclonedx/cyclonedx-library": "10.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@repo/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.112.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "file-type": "^16.5.4",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "libxmljs2": "0.35.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "packageurl-js": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "saxes": "6.0.0",
    "sharp": "^0.35.3",
    "stream-json": "^1.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.12",
    "@types/stream-json": "^1.7.8",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.9.0",
    "globals": "^16.5.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.d.ts",
      "!**/database.types.ts"
    ],
    "setupFiles": [
      "<rootDir>/test-env.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov"
    ],
    "testEnvironment": "node"
  }
}
