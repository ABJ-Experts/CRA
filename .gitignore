# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
# NOTE: `.env` alone is an EXACT-match pattern, so `.env.production` and
# `.env.staging` were committable. `.env*` closes that, with example files
# explicitly re-included.
.env*
!.env.example
!.env*.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
.docusaurus
.cache-loader
*.tsbuildinfo

# Supabase (supabase/.gitignore also covers these; belt and braces)
**/supabase/.temp/
**/supabase/.branches/

# Terraform
# .terraform.lock.hcl is deliberately NOT ignored — it must be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
