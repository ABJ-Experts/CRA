# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Repository documentation
docs/

# M14-03 implementation and verification documents are reviewable source.
!docs/
docs/*
!docs/architecture/
docs/architecture/*
!docs/architecture/m14-03*.md
!docs/architecture/m14-03*.json
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/plans/
docs/superpowers/plans/*
!docs/superpowers/plans/2026-10-09-m14-03*.md

# Local env files
# NOTE: `.env` alone is an EXACT-match pattern, so `.env.production` and
# `.env.staging` were committable. `.env*` closes that, with example files
# explicitly re-included.
.env*
!.env.example
!.env*.example

# Testing
coverage
**/test-results/
**/playwright-report/
/artifacts/**/*.png
/artifacts/**/*.log
/artifacts/**/*.zip
/artifacts/**/extract-*/
/artifacts/**/corrupt-*/
/docs/architecture/evidence/**/*.png

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
.docusaurus
.cache-loader
*.tsbuildinfo

# Supabase (supabase/.gitignore also covers these; belt and braces)
**/supabase/.temp/
**/supabase/.branches/

# Terraform
# .terraform.lock.hcl is deliberately NOT ignored — it must be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

*.playwright-mcp
